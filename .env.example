# Copy this file to .env and fill in your Supabase credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service_role key (Secret! Never share, never commit to public repos)
# Used by the dev-only /api/dev-signup endpoint to create users without email OTP.
# Get it from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Development: set to "true" to bypass email OTP verification after signup.
# When enabled, /register calls the server endpoint instead of supabase.auth.signUp(),
# so no confirmation email is sent and the user is auto-logged in.
VITE_DEV_BYPASS_EMAIL=true

# ═══════════════════════════════════════════════════════════════
# NEW FEATURES — Credit Coupon Poin + Payment Gateway (free)
# ═══════════════════════════════════════════════════════════════
# Run `supabase migration up` to apply 00003_points_payment.sql
# This adds: credit_coupons, redemption_items, redemption_requests,
# payment_banks, payment_confirmations tables.
#
# Payment gateway: manual bank transfer (truly free).
# Configure bank accounts via Dashboard Perusahaan → Kelola Bank.
# No API key or third-party service needed.
#
# ─── Midtrans Payment Gateway (Sandbox) ─────────────────────
# Get your keys at: https://dashboard.sandbox.midtrans.com/
# Sign up for free → Settings → Access Keys
# Sandbox Server Key starts with "SB-Mid-server-"
# Sandbox Client Key starts with "SB-Mid-client-"
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key-here
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key-here
# Set to "true" for sandbox, "false" for production
VITE_MIDTRANS_IS_PRODUCTION=false

# QRIS, Bank Transfer, GoPay, OVO, DANA all available in sandbox.
# Test cards: https://docs.midtrans.com/en/technical-reference/sandbox-test
